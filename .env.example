## Local dev secrets. Copy to .env (gitignored). `vp dev` / wrangler load it into the Worker env.
## Deployed envs: `npx wrangler secret put <NAME> --env staging|production`.

# Claude API key (required) - https://platform.claude.com
ANTHROPIC_API_KEY=

# Deepgram API key (optional - voice input). Typed directions work without it.
DEEPGRAM_API_KEY=

# Optional shared password for /api/* (recommended on deployed envs so nobody else spends your tokens).
APP_PASSWORD=
