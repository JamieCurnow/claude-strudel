{
  "name": "claude-strudel",
  "version": "0.1.0",
  "private": true,
  "description": "Direct a live Strudel set in plain English. Claude writes and evolves the code, quantised to the bar.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:staging": "CLOUDFLARE_ENV=staging vp build",
    "build:production": "CLOUDFLARE_ENV=production vp build",
    "preview": "vp preview",
    "check": "vp check",
    "typecheck": "vue-tsc -b",
    "test": "vp test",
    "verify": "vp check && vue-tsc -b && vp test && vp build",
    "reference": "node scripts/build-reference.mjs",
    "cf-types": "wrangler types --env-interface Env worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@strudel/core": "^1.2.6",
    "@strudel/draw": "^1.2.6",
    "@strudel/hydra": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "partial-json": "^0.1.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@strudel/reference": "^1.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "esbuild@0.28.2": true
  }
}
