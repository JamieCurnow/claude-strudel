{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#shared/*": ["./shared/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "src/types/**/*.d.ts",
    "src/**/*.test.ts",
    "shared/**/*.test.ts",
    "worker/**/*.test.ts"
  ]
}
